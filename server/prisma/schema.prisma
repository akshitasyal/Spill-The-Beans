// ============================================================
//  SPILL THE BEANS — Prisma Schema
//  Database: PostgreSQL
//  ORM: Prisma v5
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PLACED
  PACKED
  ROASTED
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  STRIPE
  COD
  UPI
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

// ─────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique @map("clerk_id")
  email     String   @unique
  name      String?
  phone     String?
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  addresses Address[]
  cart      Cart?
  wishlist  Wishlist[]
  orders    Order[]
  reviews   Review[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// CATEGORY
// ─────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  image       String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Nested Category self-relation
  parentId    String?   @map("parent_id")
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToCategory")

  // Relations
  products Product[]

  @@map("categories")
}

// ─────────────────────────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Int      // stored in paise (1 INR = 100 paise)
  salePrice   Int?     @map("sale_price")
  images      String[] // array of image URLs
  sku         String?  @unique
  variants    Json?    // Array of variants: [{price, salePrice, sku, stock, weight}]
  stock       Int      @default(0)
  weight      String?  // e.g. "200g", "100g"
  roast       String?  // Light, Medium, Dark etc.
  origin      String?
  process     String?
  flavourNotes String[] @map("flavour_notes")
  highlights  String[]
  isActive    Boolean  @default(true) @map("is_active")
  isFeatured  Boolean  @default(false) @map("is_featured")
  isBestseller Boolean @default(false) @map("is_bestseller")
  isNew       Boolean  @default(false) @map("is_new")
  isLimited   Boolean  @default(false) @map("is_limited")
  limitedQty  Int?     @map("limited_qty")
  categoryId  String   @map("category_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  category   Category    @relation(fields: [categoryId], references: [id])
  cartItems  CartItem[]
  wishlist   Wishlist[]
  orderItems OrderItem[]
  reviews    Review[]
  inventoryLogs InventoryLog[]

  @@map("products")
}


// ─────────────────────────────────────────────────────────────
// CART
// ─────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String  @map("cart_id")
  productId String  @map("product_id")
  quantity  Int     @default(1)
  variant   String? // e.g. "250g", "500g" for future use

  // Relations
  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  // Prevent duplicate product+variant in same cart
  @@unique([cartId, productId, variant])
  @@map("cart_items")
}

// ─────────────────────────────────────────────────────────────
// WISHLIST
// ─────────────────────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  // One wishlist entry per user+product
  @@unique([userId, productId])
  @@map("wishlists")
}

// ─────────────────────────────────────────────────────────────
// ADDRESS
// ─────────────────────────────────────────────────────────────

model Address {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false) @map("is_default")

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

// ─────────────────────────────────────────────────────────────
// ORDER
// ─────────────────────────────────────────────────────────────

model Order {
  id                String        @id @default(cuid())
  userId            String        @map("user_id")
  addressId         String        @map("address_id")
  status            OrderStatus   @default(PLACED)
  paymentMethod     PaymentMethod @map("payment_method")
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  couponId          String?       @map("coupon_id")
  subtotal          Int           // in paise
  discount          Int           @default(0)
  shippingFee       Int           @default(0) @map("shipping_fee")
  total             Int           // in paise
  trackingId        String?       @map("tracking_id")
  courierPartner    String?       @map("courier_partner")
  estimatedDelivery DateTime?     @map("estimated_delivery")
  notes             String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relations
  user           User            @relation(fields: [userId], references: [id])
  address        Address         @relation(fields: [addressId], references: [id])
  coupon         Coupon?         @relation(fields: [couponId], references: [id])
  items          OrderItem[]
  payment        Payment?
  trackingEvents TrackingEvent[]
  auditLogs      OrderAuditLog[]

  @@map("orders")
}

// ─────────────────────────────────────────────────────────────
// TRACKING EVENT
// ─────────────────────────────────────────────────────────────

model TrackingEvent {
  id             String      @id @default(cuid())
  orderId        String      @map("order_id")
  status         OrderStatus
  message        String?
  updatedBy      String      @default("System") @map("updated_by")
  courierPartner String?     @map("courier_partner")
  trackingNumber String?     @map("tracking_number")
  createdAt      DateTime    @default(now()) @map("created_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("tracking_events")
}

// ─────────────────────────────────────────────────────────────
// ORDER AUDIT LOG
// ─────────────────────────────────────────────────────────────

model OrderAuditLog {
  id         String       @id @default(cuid())
  orderId    String       @map("order_id")
  actorName  String       @map("actor_name")
  action     String
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus? @map("to_status")
  details    String?
  createdAt  DateTime     @default(now()) @map("created_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_audit_logs")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  name      String  // snapshot at time of purchase
  image     String  // snapshot at time of purchase
  price     Int     // in paise, snapshot at time of purchase
  quantity  Int
  variant   String?

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────────────────────────

model Payment {
  id                 String        @id @default(cuid())
  orderId            String        @unique @map("order_id")
  method             PaymentMethod
  status             PaymentStatus @default(PENDING)
  amount             Int           // in paise
  currency           String        @default("INR")
  razorpayOrderId    String?       @map("razorpay_order_id")
  razorpayPaymentId  String?       @map("razorpay_payment_id")
  stripeSessionId    String?       @map("stripe_session_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ─────────────────────────────────────────────────────────────
// COUPON
// ─────────────────────────────────────────────────────────────

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique @db.VarChar(32)
  type           CouponType
  value          Int        // percentage (0-100) or fixed amount (paise)
  minOrderAmount Int?       @map("min_order_amount") // minimum cart total to apply (paise)
  maxDiscount    Int?       @map("max_discount")     // cap on discount (paise)
  usageLimit     Int?       @map("usage_limit")      // max total uses
  usageCount     Int        @default(0) @map("usage_count")
  perUserLimit   Int?       @default(1) @map("per_user_limit")
  isActive       Boolean    @default(true) @map("is_active")
  expiresAt      DateTime?  @map("expires_at")
  createdAt      DateTime   @default(now()) @map("created_at")

  // Relations
  orders Order[]

  @@map("coupons")
}

// ─────────────────────────────────────────────────────────────
// REVIEW
// ─────────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  rating    Int      // 1-5
  title     String?
  body      String?
  isApproved Boolean @default(false) @map("is_approved")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  // One review per user per product
  @@unique([userId, productId])
  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────────────────────────

enum NotificationType {
  LOW_STOCK
  NEW_ORDER
  FAILED_PAYMENT
  NEW_REVIEW
  COUPON_EXPIRY
  NEWSLETTER_SIGNUP
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
// NEWSLETTER SUBSCRIBER
// ─────────────────────────────────────────────────────────────

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String?
  status        SubscriberStatus @default(SUBSCRIBED)
  source        String?          // e.g. "Website Popup", "Checkout Opt-in"
  subscribedAt  DateTime         @default(now()) @map("subscribed_at")
  lastEmailSentAt DateTime?      @map("last_email_sent_at")

  @@map("newsletter_subscribers")
}

// ─────────────────────────────────────────────────────────────
// INVENTORY LOG
// ─────────────────────────────────────────────────────────────

model InventoryLog {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  productName   String   @map("product_name")
  change        Int      // positive = restock, negative = sale/deduction
  previousStock Int      @map("previous_stock")
  newStock      Int      @map("new_stock")
  reason        String
  admin         String   @default("System")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory_logs")
}

