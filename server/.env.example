# ============================================================
#  Spill The Beans — Server Environment Variables Template
#  Copy to .env in /server for local development
# ============================================================

# ── Server Config ──
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Database Connectivity ──
# PostgreSQL database URI used by Prisma ORM
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spill_the_beans?schema=public

# ── Clerk Authentication ──
# Clerk Secret API keys for verifying user sessions
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_secret_here

# ── Payment Gateways ──
# Razorpay API Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here

# Stripe API Credentials
STRIPE_SECRET_KEY=sk_test_your_secret_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# ── SMTP Email System ──
# Settings for Nodemailer transactional email system
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME="Spill The Beans"
SMTP_FROM_EMAIL=no-reply@spillthebeans.in

# ── Sentry Error Monitoring ──
# DSN URI for error tracking
SENTRY_DSN=https://your_sentry_dsn_here

# ── Analytics & Search Console ──
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_SEARCH_CONSOLE_KEY=google-verification-code
