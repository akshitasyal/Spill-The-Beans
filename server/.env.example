# ============================================================
# Spill The Beans — Backend Environment Variables Template
# Copy to .env for local server development or set in hosting environment
# ============================================================

# ── Server Config ──
PORT=
NODE_ENV=
CLIENT_URL=

# ── Database Connectivity ──
DATABASE_URL=
DIRECT_URL=

# ── Custom Auth (JWT) ──
JWT_SECRET=


# ── Payment Gateways ──
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── SMTP Email System ──
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

# ── Sentry Error Monitoring ──
SENTRY_DSN=

# ── Analytics & Search Console ──
GOOGLE_ANALYTICS_ID=
GOOGLE_SEARCH_CONSOLE_KEY=

# ── ShipMate 3PL Logistics Integration (Server-Side Only) ──
SHIPMATE_BASE_URL=http://localhost:8080
SHIPMATE_API_KEY=your_shipmate_api_key_here
SHIPMATE_ORGANIZATION_CODE=STB-XXXX
SHIPMATE_WEBHOOK_SECRET=your_shipmate_webhook_secret_here
SHIPMATE_PICKUP_NAME=Spill the Beans Cafe & Roastery
SHIPMATE_PICKUP_PHONE=+919876543210
SHIPMATE_PICKUP_LINE1=123 Coffee Roasters Lane, Indiranagar
SHIPMATE_PICKUP_LINE2=Near Metro Pillar 42
SHIPMATE_PICKUP_CITY=Bengaluru
SHIPMATE_PICKUP_STATE=Karnataka
SHIPMATE_PICKUP_PINCODE=560038
SHIPMATE_PICKUP_COUNTRY=India
