

# ── Server Config ──
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Database Connectivity ──
# PostgreSQL database URI used by Prisma ORM
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxxxxxx.supabase.co:5432/postgres?sslmode=require

# ── Clerk Authentication ──
# Clerk Secret API keys for verifying user sessions
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx

# ── Payment Gateways ──
# Stripe API Credentials
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx

# ── SMTP Email System ──
# Settings for Nodemailer transactional email system
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME="Spill The Beans"
SMTP_FROM_EMAIL=no-reply@spillthebeans.in

# ── Sentry Error Monitoring ──
# DSN URI for error tracking
SENTRY_DSN=https://your_sentry_dsn_here

# ── Analytics & Search Console ──
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_SEARCH_CONSOLE_KEY=google-verification-code
