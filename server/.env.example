# ============================================================
# Spill The Beans — Backend Environment Variables Template
# Copy to .env for local server development or set in hosting environment
# ============================================================

# ── Server Config ──
PORT=
NODE_ENV=
CLIENT_URL=

# ── Database Connectivity ──
DATABASE_URL=
