SMTP_FROM_EMAIL=

# ── Sentry Error Monitoring ──
SENTRY_DSN=

# ── Analytics & Search Console ──
GOOGLE_ANALYTICS_ID=
GOOGLE_SEARCH_CONSOLE_KEY=
