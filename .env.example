# ============================================================
#  Spill The Beans — Frontend Environment Variables Template
#  Copy to .env for local development or set in hosting platform
# ============================================================

# ── Clerk Authentication ──
# Clerk Publishable Key (from Dashboard -> API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxx

# ── API Connection ──
# URL pointing to the Express server API gateway
VITE_API_URL=http://localhost:4000

# ── General Config ──
# Set to 'true' to show maintenance page to all users (admins excluded)
VITE_MAINTENANCE_MODE=false
