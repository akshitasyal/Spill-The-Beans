# ============================================================
# Spill The Beans — Frontend Environment Variables Template
# Copy to .env for local development or set in hosting platform
# ============================================================

# ── Clerk Authentication ──
VITE_CLERK_PUBLISHABLE_KEY=

# ── API Connection ──
VITE_API_URL=

# ── General Config ──
VITE_MAINTENANCE_MODE=

# Note: ShipMate logistics credentials (SHIPMATE_API_KEY, SHIPMATE_BASE_URL)
# reside strictly on the server-side (/server/.env) and are never exposed to the frontend.
